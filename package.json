{
  "name": "elbasha-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static bilingual (Arabic-first) website for El Basha for General Supplies & Contracting.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check.mjs",
    "build:drafts": "node scripts/build.mjs --drafts && node scripts/check.mjs --drafts",
    "preview": "node scripts/serve.mjs",
    "check": "node scripts/check.mjs",
    "media": "npm install --no-save --no-package-lock sharp@0.34 && node scripts/media.mjs",
    "video": "node scripts/video.mjs"
  }
}
