# Copy to .env for local builds, or set in Cloudflare Pages → Settings → Variables.
# No secrets are needed by this site. These values are public URLs.

# Absolute production URL, no trailing slash. Used for canonical, hreflang,
# Open Graph URLs, sitemap.xml and robots.txt. If unset, those tags are omitted
# and the build prints a warning.
SITE_URL=https://example.pages.dev

# Optional: path to an ffmpeg binary for `npm run video` (defaults to "ffmpeg" on PATH).
# FFMPEG=C:\tools\ffmpeg\bin\ffmpeg.exe
